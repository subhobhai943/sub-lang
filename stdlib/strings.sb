# ============================================================
# SUB Standard Library - strings
#
#   import "strings"
#
# Everything here produces identical output through all ten backends and the
# interpreter; tests/conformance/19_stdlib.sb and 21_strings.sb check it.
#
# This module used to stop at padding, because `substring`, `char_at`,
# `contains`, `replace`, `split` and `join` existed only in the interpreter
# and anything built on them failed to compile under `sub` and `subc`. They
# are wired into all ten backends now, so searching and cutting live here too.
# ============================================================

fn is_empty(s: string): bool {
    return len(s) == 0
}

fn is_blank(s: string): bool {
    return len(trim(s)) == 0
}

# `s` written `times` times. A count of zero or less gives "".
fn repeat(s: string, times: int): string {
    let out = ""
    let i = 0
    while i < times {
        out = out + s
        i = i + 1
    }
    return out
}

# Compare ignoring case, which `==` does not.
fn eq_ignore_case(a: string, b: string): bool {
    return lower(a) == lower(b)
}

# `s` padded on the left with `pad` until it is `width` long. A string already
# that long is returned unchanged -- padding never truncates.
fn pad_left(s: string, width: int, pad: string): string {
    let out = s
    while len(out) < width {
        out = pad + out
    }
    return out
}

fn pad_right(s: string, width: int, pad: string): string {
    let out = s
    while len(out) < width {
        out = out + pad
    }
    return out
}

# `s` centred in `width`, with any odd column going to the right.
fn center(s: string, width: int, pad: string): string {
    let out = s
    let left = true
    while len(out) < width {
        if left {
            out = pad + out
        } else {
            out = out + pad
        }
        left = !left
    }
    return out
}

# A line of `n` copies of `s`, which is what a report separator wants.
fn line(s: string, n: int): string {
    return repeat(s, n)
}

# ---------- searching ----------

# The index of the first occurrence of `needle`, or -1. An empty needle is
# found at 0, which is what `contains` reports for it too.
fn find(s: string, needle: string): int {
    let n = len(s)
    let m = len(needle)
    if m == 0 {
        return 0
    }
    let i = 0
    while i + m <= n {
        if substring(s, i, i + m) == needle {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn starts_with(s: string, prefix: string): bool {
    return substring(s, 0, len(prefix)) == prefix
}

fn ends_with(s: string, suffix: string): bool {
    let n = len(s)
    let m = len(suffix)
    if m > n {
        return false
    }
    return substring(s, n - m, n) == suffix
}

# How many non-overlapping times `needle` occurs. Cutting on it and counting
# the pieces is both shorter and harder to get wrong than a search loop.
fn count_of(s: string, needle: string): int {
    if len(needle) == 0 {
        return 0
    }
    return len(split(s, needle)) - 1
}

# ---------- trimming to shape ----------

fn strip_prefix(s: string, prefix: string): string {
    if starts_with(s, prefix) {
        return substring(s, len(prefix), len(s))
    }
    return s
}

fn strip_suffix(s: string, suffix: string): string {
    if ends_with(s, suffix) {
        return substring(s, 0, len(s) - len(suffix))
    }
    return s
}

# `s` cut to `width`, with the last characters given over to `ellipsis` when
# something was actually removed. A width shorter than the ellipsis just cuts.
fn truncate(s: string, width: int, ellipsis: string): string {
    if len(s) <= width {
        return s
    }
    if width <= len(ellipsis) {
        return substring(s, 0, width)
    }
    return substring(s, 0, width - len(ellipsis)) + ellipsis
}

# ---------- reshaping ----------

fn reverse(s: string): string {
    let out = ""
    let i = len(s) - 1
    while i >= 0 {
        out = out + char_at(s, i)
        i = i - 1
    }
    return out
}

fn capitalize(s: string): string {
    if len(s) == 0 {
        return s
    }
    return upper(char_at(s, 0)) + lower(substring(s, 1, len(s)))
}

# Every space-separated word capitalized. Runs of spaces are preserved, since
# splitting keeps empty fields.
fn title(s: string): string {
    let parts = split(s, " ")
    let out = []
    for w in parts {
        push(out, capitalize(w))
    }
    return join(out, " ")
}

# The words of `s`, with empty fields dropped -- which is what a run of spaces
# or a leading space would otherwise leave behind.
fn words(s: string) {
    let out = []
    for w in split(trim(s), " ") {
        if len(w) > 0 {
            push(out, w)
        }
    }
    return out
}

fn lines(s: string) {
    return split(s, "\n")
}

# Only the first occurrence, where `replace` changes every one.
fn replace_first(s: string, old: string, repl: string): string {
    if len(old) == 0 {
        return s
    }
    let at = find(s, old)
    if at < 0 {
        return s
    }
    return substring(s, 0, at) + repl + substring(s, at + len(old), len(s))
}

# ---------- character class tests ----------

let _alpha = "abcdefghijklmnopqrstuvwxyz"
let _digits = "0123456789"

# True when every character is a letter (a-z, A-Z). Empty string is false.
fn is_alpha(s: string): bool {
    if len(s) == 0 {
        return false
    }
    let low = lower(s)
    let i = 0
    while i < len(s) {
        let c = char_at(low, i)
        if find(_alpha, c) < 0 {
            return false
        }
        i = i + 1
    }
    return true
}

# True when every character is a digit (0-9). Empty string is false.
fn is_digit(s: string): bool {
    if len(s) == 0 {
        return false
    }
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if find(_digits, c) < 0 {
            return false
        }
        i = i + 1
    }
    return true
}

# True when every character is a digit, dot, or minus sign — a rough
# numeric check that accepts things like "3.14" and "-7".
fn is_numeric(s: string): bool {
    if len(s) == 0 {
        return false
    }
    let i = 0
    let dots = 0
    while i < len(s) {
        let c = char_at(s, i)
        if find(_digits, c) >= 0 {
            i = i + 1
        } else if c == "." {
            dots = dots + 1
            if dots > 1 {
                return false
            }
            i = i + 1
        } else if c == "-" && i == 0 {
            i = i + 1
        } else {
            return false
        }
    }
    return true
}

# ---------- case conversion ----------

let _upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

# "Hello World" → "hello_world"
fn snake_case(s: string): string {
    let out = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == " " || c == "-" {
            out = out + "_"
        } else if find(_upper, c) >= 0 {
            if i > 0 {
                let prev = char_at(s, i - 1)
                if prev != " " && prev != "-" && prev != "_" {
                    out = out + "_"
                }
            }
            out = out + lower(c)
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

# "hello world" → "helloWorld"
fn camel_case(s: string): string {
    let parts = split(lower(s), " ")
    let out = str(parts[0])
    let i = 1
    while i < len(parts) {
        let w = str(parts[i])
        if len(w) > 0 {
            out = out + capitalize(w)
        }
        i = i + 1
    }
    return out
}

# Make a URL/file-safe string: lowercase, spaces to hyphens, strip non-alnum.
fn slugify(s: string): string {
    let low = lower(s)
    let out = ""
    let i = 0
    while i < len(low) {
        let c = char_at(low, i)
        if is_alpha(c) {
            out = out + c
        }
        if is_digit(c) {
            out = out + c
        }
        if c == " " {
            out = out + "-"
        }
        i = i + 1
    }
    return out
}

# ---------- HTML ----------

# Replace the five characters that are special in HTML with their entity
# equivalents. Enough for interpolating user text into HTML attributes and
# element bodies; not a full sanitiser.
fn escape_html(s: string): string {
    let out = replace(s, "&", "&amp;")
    out = replace(out, "<", "&lt;")
    out = replace(out, ">", "&gt;")
    out = replace(out, "\"", "&quot;")
    return out
}

# ---------- text layout ----------

# Indent every line of `s` by `n` spaces.
fn indent(s: string, n: int): string {
    let pad = ""
    let i = 0
    while i < n {
        pad = pad + " "
        i = i + 1
    }
    let ls = lines(s)
    let out = ""
    let j = 0
    while j < len(ls) {
        if j > 0 {
            out = out + "\n"
        }
        if len(ls[j]) > 0 {
            out = out + pad + ls[j]
        }
        j = j + 1
    }
    return out
}

# ---------- palindrome ----------

fn is_palindrome(s: string): bool {
    let rev = reverse(lower(s))
    return lower(s) == rev
}

# ---------- common prefix / suffix ----------

# The longest string that both `a` and `b` start with.
fn common_prefix(a: string, b: string): string {
    let n = len(a)
    if len(b) < n {
        n = len(b)
    }
    let i = 1
    while i <= n {
        if substring(a, 0, i) != substring(b, 0, i) {
            return substring(a, 0, i - 1)
        }
        i = i + 1
    }
    return substring(a, 0, n)
}

# The longest string that both `a` and `b` end with.
fn common_suffix(a: string, b: string): string {
    let ra = reverse(a)
    let rb = reverse(b)
    return reverse(common_prefix(ra, rb))
}
