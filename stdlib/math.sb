# ============================================================
# SUB Standard Library - math
#
#   import "math"
#
# Built only on operations every backend implements: + - * / % **,
# comparisons, and the abs/min/max/sqrt/floor/ceil/round builtins. Nothing
# here needs a builtin that only the interpreter has, which is why the same
# results come out of all ten backends.
#
# Integer and floating-point helpers are kept apart -- sum_int and sum_float
# rather than one sum -- because the statically typed backends infer a single
# concrete signature per function, and one that returned an int here and a
# float there would not compile.
# ============================================================

const PI  = 3.141592653589793
const E   = 2.718281828459045
const TAU = 6.283185307179586

# ---------- sign and range ----------

# -1, 0 or 1 according to the sign of x.
fn sign(x: int): int {
    if x > 0 {
        return 1
    }
    if x < 0 {
        return 0 - 1
    }
    return 0
}

# x confined to [lo, hi].
fn clamp(x: int, lo: int, hi: int): int {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

fn is_even(n: int): bool {
    return n % 2 == 0
}

fn is_odd(n: int): bool {
    return n % 2 != 0
}

# ---------- integer arithmetic ----------

# Greatest common divisor, by Euclid. Negative inputs give a positive result.
fn gcd(a: int, b: int): int {
    let x = a
    let y = b
    if x < 0 {
        x = 0 - x
    }
    if y < 0 {
        y = 0 - y
    }
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    return x
}

# Least common multiple. lcm(0, n) is 0.
fn lcm(a: int, b: int): int {
    if a == 0 {
        return 0
    }
    if b == 0 {
        return 0
    }
    let g = gcd(a, b)
    let m = a / g * b
    if m < 0 {
        return 0 - m
    }
    return m
}

# n! for n >= 0; factorial(0) is 1. Overflows past 20 on a 64-bit integer.
fn factorial(n: int): int {
    let acc = 1
    let i = 2
    while i <= n {
        acc = acc * i
        i = i + 1
    }
    return acc
}

# The nth Fibonacci number, counting fib(0) = 0 and fib(1) = 1.
fn fib(n: int): int {
    if n < 2 {
        return n
    }
    let a = 0
    let b = 1
    let i = 2
    while i <= n {
        let next = a + b
        a = b
        b = next
        i = i + 1
    }
    return b
}

# Trial division up to the square root. 0 and 1 are not prime.
fn is_prime(n: int): bool {
    if n < 2 {
        return false
    }
    if n < 4 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    let d = 3
    while d * d <= n {
        if n % d == 0 {
            return false
        }
        d = d + 2
    }
    return true
}

# base raised to a non-negative integer power, by repeated squaring.
# `**` is the operator form; this is the one to call when the exponent is a
# value rather than something written in the source.
fn ipow(base: int, exp: int): int {
    if exp < 0 {
        return 0
    }
    let result = 1
    let b = base
    let e = exp
    while e > 0 {
        if e % 2 == 1 {
            result = result * b
        }
        b = b * b
        e = e / 2
    }
    return result
}

# ---------- floating point ----------

fn hypot(a: float, b: float): float {
    return sqrt(a * a + b * b)
}

fn deg_to_rad(deg: float): float {
    return deg * PI / 180.0
}

fn rad_to_deg(rad: float): float {
    return rad * 180.0 / PI
}

# Whether two floats are within `tol` of one another. Comparing floats with
# == is a trap in any language; this is the comparison to reach for.
fn close_to(a: float, b: float, tol: float): bool {
    let d = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= tol
}

# x truncated to `places` decimal places, rounding halves away from zero.
fn round_to(x: float, places: int): float {
    let scale = 1.0
    let i = 0
    while i < places {
        scale = scale * 10.0
        i = i + 1
    }
    return round(x * scale) / scale
}
