# ============================================================
# SUB Standard Library - io
#
#   import "io"
#
# Printing itself is a builtin -- `print` writes, `println` writes a line --
# so this module is the layer above that: colour, and the column alignment a
# table needs. All of it is string building, which is portable; none of it
# needs a builtin the compiled backends lack.
#
# The colours are ANSI escapes. A terminal renders them; a file or a pipe
# gets the escape bytes literally, so use `plain` output when writing data
# something else will read.
# ============================================================

import "strings"

const ESC   = "["
const RESET = "[0m"

fn red(s: string): string     { return ESC + "31m" + s + RESET }
fn green(s: string): string   { return ESC + "32m" + s + RESET }
fn yellow(s: string): string  { return ESC + "33m" + s + RESET }
fn blue(s: string): string    { return ESC + "34m" + s + RESET }
fn magenta(s: string): string { return ESC + "35m" + s + RESET }
fn cyan(s: string): string    { return ESC + "36m" + s + RESET }
fn bold(s: string): string    { return ESC + "1m"  + s + RESET }
fn dim(s: string): string     { return ESC + "2m"  + s + RESET }

# ---------- labelled lines ----------

fn info(message: string): void {
    println(cyan("info") + "  " + message)
}

fn ok(message: string): void {
    println(green("ok") + "    " + message)
}

fn warn(message: string): void {
    println(yellow("warn") + "  " + message)
}

fn fail(message: string): void {
    println(red("fail") + "  " + message)
}

# ---------- tables ----------

# One row of a table: `cells` padded to `width` columns and separated by two
# spaces. Cells longer than the width are not truncated -- losing data to make
# a column line up is the wrong trade.
fn row(cells, width: int): string {
    let out = ""
    let i = 0
    while i < len(cells) {
        if i > 0 {
            out = out + "  "
        }
        out = out + pad_right(cells[i], width, " ")
        i = i + 1
    }
    return trim(out)
}

# A rule the width of a table with `columns` columns of `width` each.
fn rule(columns: int, width: int): string {
    let total = columns * width
    if columns > 1 {
        total = total + (columns - 1) * 2
    }
    return repeat("-", total)
}

fn heading(title: string): void {
    println(bold(title))
    println(repeat("-", len(title)))
}
