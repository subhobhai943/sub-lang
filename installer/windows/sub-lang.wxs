<?xml version="1.0" encoding="UTF-8"?>
<!--
  SUB Language Windows MSI Installer
  Built with WiX Toolset v4 (wix.exe)

  Installs sub.exe, subc.exe and subi.exe under
    %ProgramFiles%\SUB Language\
  optionally adds that directory to the system PATH, and associates .sb
  files with the interpreter.

  The version comes in as a preprocessor variable:

    wix build sub-lang.wxs -d Version=1.0.8.0 -ext WixToolset.UI.wixext

  It used to be bind.FileVersion.sub.exe, which cannot work: the binaries
  are built by MinGW without a version resource, so there is no file
  version to bind to. The release workflow papered over that by rewriting
  this file with a regular expression before every build. A variable is
  the mechanism WiX provides for exactly this, and it leaves the source
  the same file that ships.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?ifndef Version ?>
    <?define Version = "0.0.0.0" ?>
  <?endif?>

  <Package
    Name="SUB Language"
    Manufacturer="SUB Language Project"
    Version="$(Version)"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes">

    <!-- The UpgradeCode must never change: Windows uses it to recognise an
         existing install as the same product. A new one would leave earlier
         versions installed alongside this one. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of SUB Language is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Shown in Apps &amp; features / Add-Remove Programs. Without these the
         entry has no icon, no version and no way back to the project. -->
    <Icon Id="SubIcon" SourceFile="sub-lang.ico" />
    <Property Id="ARPPRODUCTICON" Value="SubIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/subhobhai943/sub-lang" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/subhobhai943/sub-lang" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/subhobhai943/sub-lang/releases" />
    <Property Id="ARPCONTACT" Value="SUB Language Project" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="SUB Language">
        <Directory Id="STDLIBDIR" Name="stdlib" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="SUB Language" />
    </StandardDirectory>

    <!-- ── Components ────────────────────────────────────────────────
         One per file rather than one for all of them, so that the .sb
         association can hang off subi.exe (the program that opens them)
         and PATH can be a feature the user is allowed to decline. -->

    <ComponentGroup Id="Tools" Directory="INSTALLDIR">
      <Component Id="SubExe" Guid="A5B59802-2B3B-4E0D-ACE5-4E9738E214BC">
        <File Id="sub.exe" Source="sub.exe" KeyPath="yes" />
      </Component>

      <Component Id="SubcExe" Guid="8E95B6A7-A9F0-4EDC-8700-CE2F763983CD">
        <File Id="subc.exe" Source="subc.exe" KeyPath="yes" />
      </Component>

      <Component Id="SubiExe" Guid="94D68308-C5A7-4F27-8270-107C523029CF">
        <File Id="subi.exe" Source="subi.exe" KeyPath="yes" />
        <!-- Double-clicking a .sb file runs it under the interpreter. -->
        <ProgId Id="SUBLanguage.Source"
                Description="SUB source file"
                Icon="subi.exe">
          <Extension Id="sb" ContentType="text/x-sub">
            <Verb Id="open" Command="Run"
                  TargetFile="subi.exe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
      </Component>

      <Component Id="Docs" Guid="8AB4BC1E-3F45-462D-86E5-19A7AD4AF343">
        <File Id="LICENSE" Source="LICENSE" KeyPath="yes" />
        <File Id="README" Source="README.md" />
      </Component>
    </ComponentGroup>

    <!-- The standard library, in the directory the module resolver looks in:
         stdlib\ beside the executables. Without it `import "math"` finds
         nothing on a Windows install. -->
    <ComponentGroup Id="StdLib" Directory="STDLIBDIR">
      <Component Id="StdLibFiles" Guid="3F1C6A54-90D2-4E7B-9A28-5C0E1B7F4D63">
        <File Id="stdlib.math" Source="stdlib\math.sb" KeyPath="yes" />
        <File Id="stdlib.arrays" Source="stdlib\arrays.sb" />
        <File Id="stdlib.strings" Source="stdlib\strings.sb" />
        <File Id="stdlib.io" Source="stdlib\io.sb" />
        <File Id="stdlib.readme" Source="stdlib\README.md" />
      </Component>
    </ComponentGroup>

    <!-- Optional: put the tools on the system PATH. Its own feature, so
         someone who manages PATH themselves can turn it off in the
         installer rather than having it done to them. -->
    <ComponentGroup Id="PathEntry" Directory="INSTALLDIR">
      <Component Id="AddToPath" Guid="0FA9B12D-9A31-41E0-B47A-FC2B3949AF50">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLDIR]"
                     Permanent="no" Part="last" Action="set" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\SUBLanguage"
                       Name="PathEntry" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="AppMenuFolder">
      <Component Id="StartMenuShortcuts" Guid="00E1D52C-002A-4A67-B935-DD2ED189E070">
        <Shortcut Id="SubInterpreterShortcut"
                  Name="SUB Interpreter"
                  Description="Run the SUB Language interpreter (subi)"
                  Target="[INSTALLDIR]subi.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="SubIcon" />
        <Shortcut Id="SubReadmeShortcut"
                  Name="SUB Language README"
                  Description="Open the SUB Language README"
                  Target="[INSTALLDIR]README.md"
                  WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="CleanAppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SUBLanguage"
                       Name="Shortcuts" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ── Features ───────────────────────────────────────────────── -->

    <Feature Id="ProductFeature"
             Title="SUB Language Toolchain"
             Description="The sub transpiler, subc native compiler and subi interpreter."
             Level="1"
             AllowAbsent="no">
      <ComponentGroupRef Id="Tools" />
      <ComponentGroupRef Id="StdLib" />

      <Feature Id="PathFeature"
               Title="Add to system PATH"
               Description="Run sub, subc and subi from any command prompt."
               Level="1">
        <ComponentGroupRef Id="PathEntry" />
      </Feature>

      <Feature Id="ShortcutFeature"
               Title="Start Menu shortcuts"
               Description="Shortcuts to the interpreter and the README."
               Level="1">
        <ComponentGroupRef Id="Shortcuts" />
      </Feature>
    </Feature>

    <!-- A licence page, a directory chooser and a feature tree, rather than
         an installer that starts writing to Program Files the moment it is
         double-clicked. -->
    <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLDIR" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
