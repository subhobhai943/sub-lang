*.swo
*~

# IDE and editor files
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# Build directories
build/
dist/
out/
target/

# Test outputs
*_output.txt
test_output/
output.*
output_*

# Generated transpiled files (allow in examples/tests)
*.py
test_hello.c
!.github/scripts/opencode.py
*.js
*.css
*.html
*.rb
*.java
*.cpp
*.rs
*.kt
*.swift
# Anchored to the repo root: transpiler output lands beside the .sb file, but
# a bare *.c / *.go would also swallow the compiler's own sources in src/.
/*.c
/*.go
!tests/*.py
!examples/*.py
!examples/*.js
!examples/*.sb

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt

# Logs
*.log

# Package manager
node_modules/
__pycache__/
*.pyc
