fn classify(n) {
    if n < 0 {
        return "negative"
    } elif n == 0 {
        return "zero"
    } else {
        return "positive"
    }
}

println(classify(-5))
println(classify(0))
println(classify(9))

let i = 0
while i < 3 {
    println(i)
    i = i + 1
}

for k in range(3) {
    println("k=" + str(k))
}
