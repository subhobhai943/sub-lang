import "json"
import "semver"
import "fs"
import "hash"
import "strings"

let value = json_parse("{\"name\":\"sub\",\"items\":[1,true,null]}")
println(value["name"])
println(json_stringify(value))
println(semver_compare("1.2.3", "1.3.0"))
println(semver_satisfies("1.4.2", "^1.2.0"))
println(semver_satisfies("1.4.2", ">=1.0.0,<2.0.0"))
println(sha256(""))
println(sha256("abc"))

let root = "package_stdlib_tmp"
ensure_dir(root + "/nested")
write_lines(root + "/nested/lines.txt", ["a", "b"])
println(read_lines(root + "/nested/lines.txt"))
println(len(walk(root)))
remove_tree(root)
