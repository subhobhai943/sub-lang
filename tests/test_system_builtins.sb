let root = "system_builtin_tmp"
mkdir(root + "/nested")
write_file(root + "/a.txt", "one")
append_file(root + "/a.txt", "two")
println(read_file(root + "/a.txt"))
println(file_exists(root + "/a.txt"))
println(is_dir(root + "/nested"))
println(list_dir(root)[0])
rename(root + "/a.txt", root + "/b.txt")
println(file_exists(root + "/b.txt"))
let result = exec("printf system-exec")
println(result.code)
println(result.out)
remove(root + "/b.txt")
remove(root + "/nested")
remove(root)
