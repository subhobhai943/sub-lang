{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SUB",
  "scopeName": "source.sub",
  "fileTypes": [
    "sb"
  ],
  "_comment": "Keyword lists here mirror kw_table in src/core/lexer.c, plus the four words the parser recognises contextually (switch, match, case, default) and `in`. tests/grammar_keywords.py checks that mirror still holds; add a keyword to the lexer without adding it here and CI fails.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sub",
          "comment": "#embed and #endembed open an embedded block; they are not comments.",
          "match": "#(?!embed\\b|endembed\\b).*$"
        },
        {
          "name": "comment.line.double-slash.sub",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sub",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sub",
          "match": "\\b(if|elif|else|for|while|do|end|break|continue|return|try|catch|finally|throw|switch|match|case|default|in)\\b"
        },
        {
          "name": "keyword.declaration.sub",
          "match": "\\b(let|const|var|fn|function|def|class|extends|implements|import)\\b"
        },
        {
          "name": "keyword.other.sub",
          "match": "\\b(embed|endembed|cpp|python|javascript|rust|ui|new|this|super|static|private|public|protected|async|await|yield)\\b"
        },
        {
          "name": "storage.type.sub",
          "match": "\\b(int|float|string|bool|auto|void)\\b"
        },
        {
          "name": "constant.language.sub",
          "match": "\\b(true|false|null|nil)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sub",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sub",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.sub",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sub",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sub",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.sub",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.sub",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.sub",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.sub",
          "comment": "** before * so a power is one operator, not two.",
          "match": "\\*\\*|\\+|\\-|\\*|/|%"
        },
        {
          "name": "keyword.operator.comparison.sub",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.sub",
          "match": "\\+=|-=|\\*=|/=|="
        },
        {
          "name": "keyword.operator.logical.sub",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.sub",
          "match": "<|>"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.sub",
          "match": "\\b(print|println|show|input|len|length|range|type|str|to_string|int|float|bool|abs|sqrt|min|max|floor|ceil|round|push|pop|append|split|join|upper|lower|trim|substring|replace|contains|char_at)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.sub",
          "comment": "A name a declaration introduces, so `fn work(...)` colours work.",
          "match": "(?<=\\b(?:fn|function|def)\\s)\\s*([A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "entity.name.function.sub",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.sub",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
